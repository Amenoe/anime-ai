# anime-ai 配置示例。复制为 .env 后填写真实值（.env 已被 .gitignore 排除，不会提交）。
#
#   cp .env.example .env
#
# 由 application.yml 的 spring.config.import 加载，无需 export 到 shell。

# ─── 对话模型（DeepSeek，OpenAI 兼容）──────────────────────────
AI_CHAT_API_KEY=
AI_CHAT_BASE_URL=https://api.deepseek.com/v1
# deepseek-flash 比 deepseek-v4-pro 便宜约 4 倍，默认够用
AI_CHAT_MODEL=deepseek-flash

# ─── 服务间鉴权 ──────────────────────────────────────────────
# 必须与 anime-chat-server 的 AI_INTERNAL_TOKEN **完全一致**，否则转发被拒 401。
# 两侧都留空 = 不校验（仅限本地开发）。
AI_INTERNAL_TOKEN=

# ─── 向量模型（M2 才用；DeepSeek 没有 embedding 接口，必须另找一家）──
# AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_MODEL=BAAI/bge-m3

# ─── M2：Qdrant 与 anime 语料库 ───────────────────────────────
# AI_QDRANT_URL=http://127.0.0.1:6333
# AI_QDRANT_COLLECTION=anime_knowledge
# ⚠️ characterEncoding 要写 Java 字符集名（UTF-8），**不能写 utf8mb4** ——
# MySQL Connector/J 9.x 会直接抛 UnsupportedEncodingException: utf8mb4，
# 表现为 /internal/knowledge/ingest 返回 500。原来的模板就踩了这个坑。
# 另外用户名/密码必须填（不能留空），否则连接会在认证阶段失败。
# 本地 anime 表当前是 0 行：配了这项就会**默认**用 mysql 作为语料源，
# 导入会得到 0 条（服务端现在会明确报 400，不再伪装成 upserted=0 的成功）。
# AI_CORPUS_JDBC_URL=jdbc:mysql://127.0.0.1:3306/anime_chat?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
# AI_CORPUS_DB_USERNAME=
# AI_CORPUS_DB_PASSWORD=

# ─── Bangumi（公开 API，需要 User-Agent）─────────────────────
# AI_BANGUMI_UA=anime-ai/0.1 (https://github.com/Amenoe/anime-chat)
