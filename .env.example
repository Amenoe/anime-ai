# anime-ai 配置示例。复制为 .env 后填写真实值（.env 已被 .gitignore 排除，不会提交）。
#
#   cp .env.example .env
#
# 由 application.yml 的 spring.config.import 加载，无需 export 到 shell。

# ─── 对话模型（DeepSeek，OpenAI 兼容）──────────────────────────
AI_CHAT_API_KEY=
AI_CHAT_BASE_URL=https://api.deepseek.com/v1
# deepseek-flash 比 deepseek-v4-pro 便宜约 4 倍，默认够用
AI_CHAT_MODEL=deepseek-flash

# ─── 服务间鉴权 ──────────────────────────────────────────────
# 必须与 anime-chat-server 的 AI_INTERNAL_TOKEN **完全一致**，否则转发被拒 401。
# 两侧都留空 = 不校验（仅限本地开发）。
AI_INTERNAL_TOKEN=

# ─── 向量模型（M2 才用；DeepSeek 没有 embedding 接口，必须另找一家）──
# AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_MODEL=BAAI/bge-m3

# ─── Bangumi（公开 API，需要 User-Agent）─────────────────────
# AI_BANGUMI_UA=anime-ai/0.1 (https://github.com/Amenoe/anime-chat)
